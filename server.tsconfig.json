{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020"],
    "strict": true,
    "esModuleInterop": true,
    "outDir": "./dist",
    "rootDir": ".",
    "baseUrl": ".",
    "paths": {
      "@/*": ["./*"]
    },
    "skipLibCheck": true,
    "resolveJsonModule": true
  },
  "include": ["server-custom.ts", "server/**/*", "types/**/*"],
  "exclude": ["node_modules", "app", "components", "hooks", "lib", "store", "utils", ".next"]
}
