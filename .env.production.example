# Live Ops Helpdesk — Production Environment Variables
# Set these in your hosting provider (Render, Railway, Fly.io, etc.)

# ── SERVER (Express + Socket.io) ──────────────────────────────
# Port the server listens on (most platforms set this automatically)
PORT=4000

# Comma-separated list of allowed frontend origins (NO trailing slashes, NO wildcards)
# Example: https://your-app.vercel.app,https://staging.your-app.vercel.app
ALLOWED_ORIGINS=https://your-frontend.vercel.app

# ── CLIENT (Next.js on Vercel) ────────────────────────────────
# Public URL of the deployed Socket.io server (use wss:// for secure WebSocket)
# Set this in your Vercel project environment variables
NEXT_PUBLIC_SOCKET_URL=https://your-backend.onrender.com
